# Copy to .env for local development. These values are public (they ship to the browser),
# but keep real values out of commits anyway. NEVER put a service-role key, Meta app secret,
# CRON_SECRET, verify token or AI key here: those live only in Supabase Edge Function secrets.
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<supabase publishable/anon key>
# From the Meta app (see SETUP.md). App and configuration IDs are not secret.
VITE_META_APP_ID=<meta app id>
VITE_META_ADS_CONFIG_ID=<facebook login for business config id (ads)>
VITE_META_WA_CONFIG_ID=<embedded signup config id (whatsapp)>
VITE_META_GRAPH_VERSION=v25.0
